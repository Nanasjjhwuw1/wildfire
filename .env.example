# Copy to .env and edit as needed:  cp .env.example .env
# Every value has a safe default in backend/config.py, so .env is optional.

# Data mode: "real" (default; live Open-Meteo + Terrarium DEM + ESA WorldCover)
# or "mock" (synthetic, offline-only dev).
DATA_MODE=real

# Study area (WGS84). Defaults cover Doi Suthep, Chiang Mai (~11 km box).
AREA_NAME=Doi Suthep, Chiang Mai
BBOX_LON_MIN=98.85
BBOX_LAT_MIN=18.74
BBOX_LON_MAX=98.95
BBOX_LAT_MAX=18.84

# Target grid cell size in metres (~100 m -> ~111x105 grid for the default box).
CELL_SIZE_M=100

# How long cached weather stays fresh before re-fetching (seconds).
WEATHER_TTL_S=3600

# Optional: NASA FIRMS map key to enable the historical-hotspot overlay.
# Get a free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=
